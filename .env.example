# ==============================================================================
# CodeSentinel AI - Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# Never commit real credentials or production secrets to source control.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=codesentinel_db
POSTGRES_USER=codesentinel_user
POSTGRES_PASSWORD=codesentinel_pass
POSTGRES_PORT=5432

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codesentinel_db
SPRING_DATASOURCE_USERNAME=codesentinel_user
SPRING_DATASOURCE_PASSWORD=codesentinel_pass

# JWT Authentication Secret (Minimum 256-bit / 32-byte hexadecimal key for HS256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
